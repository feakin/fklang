{
  "name": "fkl-vscode",
  "displayName": "FKL",
  "description": "VSCode language support for FKL.",
  "version": "0.1.0",
  "publisher": "feakin",
  "license": "MPL-2.0",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:fkl",
    "onCommand:fkl.restartLanguageServer",
    "onDebug"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fkl.restartLanguageServer",
        "title": "FKL: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "FKL",
      "properties": {
        "fkl.lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the fkl_lsp executable. Defaults to ../../target/debug/fkl_lsp from this extension directory."
        },
        "fkl.debug.adapterPath": {
          "type": "string",
          "default": "",
          "description": "Path to the fkl CLI executable used as the Debug Adapter. Defaults to ../../target/debug/fkl from this extension directory."
        }
      }
    },
    "debuggers": [
      {
        "type": "fkl",
        "label": "FKL Time Travel Debug",
        "languages": [
          "fkl"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "main": {
                "type": "string",
                "description": "Path to the main .fkl file. Defaults to the active FKL editor file."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "fkl",
            "request": "launch",
            "name": "Debug FKL Time Travel",
            "main": "${file}"
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "fkl",
        "aliases": [
          "FKL",
          "fkl"
        ],
        "extensions": [
          ".fkl"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:integration": "npm run compile && cargo build -p fkl_cli -p fkl_lsp && node out/test/integration/runTest.js",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "1.84.0",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.4.5"
  }
}
